    given-names: "Om"
    alias: "OmAcharya-avtr"
repository-code: "https://github.com/OmAcharya-avtr/acqsearch"
license: "Apache-2.0"
version: "0.1.0"
date-released: "2026-08-30"
keywords:
  - aerospace
  - pointing-acquisition-tracking
